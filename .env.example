# =============================================================================
# Voice AI pipeline configuration
# Copy to `.env` and adjust. Every variable is optional; defaults are shown.
# Never commit your real `.env`.
# =============================================================================

# --- Server -------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
# Comma-separated allowed origins for CORS, or * for any origin.
CORS_ORIGINS=*
# Max upload size (MB) for /voice-turn, /voice-turn-stream and /detect-lang.
MAX_UPLOAD_MB=20

# --- Admin panel / API (HTTP Basic auth) ---------------------------------------
# Leave ADMIN_PASSWORD empty to disable auth (local development only!).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_DB_PATH=data/admin/voice_agent.db
CONVERSATION_MEDIA_DIR=data/conversation_media

# --- WebRTC ICE ----------------------------------------------------------------
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# Optional TURN relay (recommended when clients are behind NAT), e.g.
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# --- LLM (Ollama) ----------------------------------------------------------------
# Inside docker compose this is overridden to http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b
SUMMARIZE_MODEL=llama3.2:1b
EMBED_MODEL=nomic-embed-text
SEMANTIC_CACHE_PATH=semantic_cache.json

# --- Speech models ---------------------------------------------------------------
WHISPER_MODEL=openai/whisper-small
LID_MODEL=facebook/mms-lid-256

# --- TTS -----------------------------------------------------------------------
# auto | piper | edge
TTS_BACKEND=auto
PIPER_MODELS_DIR=src/tts/piper_models
PIPER_PATH=
EDGE_TTS_VOICE_TA=ta-IN-PallaviNeural
EDGE_TTS_VOICE_KN=kn-IN-SapnaNeural
EDGE_TTS_VOICE_EN=en-US-AriaNeural
EDGE_TTS_VOICE_HI=hi-IN-SwaraNeural
EDGE_TTS_VOICE_TE=te-IN-MohanNeural
EDGE_TTS_RATE=+0%
EDGE_TTS_VOLUME=+0%
EDGE_TTS_PITCH=+0Hz

# --- Model caches (docker compose volume mounts) -----------------------------------
HF_CACHE_DIR=/mnt/scratch/hf
TORCH_CACHE_DIR=/mnt/scratch/torch

# --- Audio endpointing -------------------------------------------------------------
SILENCE_THRESHOLD=0.01
SILENCE_DURATION=2.0
MIN_SPEECH_DURATION=1.0

# --- Feature flags ----------------------------------------------------------------
ENABLE_TWILIO=true
ENABLE_LID_AUTODETECT=true
# phone | kiosk  (changes the human-handover message)
HANDOVER_MODE=phone

# --- Streaming / metrics -------------------------------------------------------------
METRICS_WINDOW=200
STREAM_CHUNK_MIN_WORDS=4
STREAM_CHUNK_MAX_QUEUE=8
STREAM_CHUNK_FLUSH_MS=800
VOICE_TURN_STREAM_ENABLED=true
VOICE_TURN_MAX_TOKENS=80

# --- Redis session context -----------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_SESSION_TTL=1800

# --- Emergency / distress detection ------------------------------------------------------
ENABLE_EMERGENCY_DETECTION=true
MIMI_MODEL=kyutai/mimi
EMERGENCY_CLASSIFIER_PATH=models/emergency_classifier.pt
DISTRESS_WINDOW=5
DISTRESS_MIN_HITS=3
EMERGENCY_THRESHOLD=0.7
